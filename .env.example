# Copie para .env em desenvolvimento local:  cp .env.example .env
# NUNCA faça commit do arquivo .env

# development | production
APP_ENV=development

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-valor-aleatorio

# --- Banco de dados MySQL ---
# Opção 1 (recomendada, é o que o Railway fornece):
# MYSQL_URL=mysql://usuario:senha@host:3306/labu
# Opção 2: variáveis separadas
# MYSQLHOST=localhost
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=senha
# MYSQLDATABASE=labu
# Sem nenhuma das opções acima (e fora de produção) o app usa SQLite local (labu_dev.db).

# --- Superusuário criado automaticamente pelo comando init-db (opcional) ---
ADMIN_EMAIL=admin@labu.local
ADMIN_PASSWORD=TroqueEstaSenha123
ADMIN_NOME=Administrador LABU

# --- Google Maps (geolocalização) - opcional ---
# Restrinja a chave por domínio (HTTP referrer) no Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# --- Acessibilidade: widget VLibras (Libras) do governo federal ---
VLIBRAS_ENABLED=true
